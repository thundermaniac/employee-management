# Copy this file to server/.env

PORT=5001

# Leave MONGODB_URI empty to run against an automatically started in-memory
# MongoDB (no setup needed). Point it at Atlas or a local mongod for real
# persistence, e.g.
# MONGODB_URI=mongodb://127.0.0.1:27017/employee_management
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/employee_management
MONGODB_URI=

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1d

CLIENT_ORIGIN=http://localhost:5173
